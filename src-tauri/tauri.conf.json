{
  "$schema": "https://schema.tauri.app/2.0.0/tauri.schema.json",
  "productName": "Isola di Studio",
  "version": "0.1.1",
  "identifier": "com.isola.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Isola di Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/vespifilippo-lab/isola-di-studio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3MEIzNTk3NEU0RkVCRkIKUldUNzYwOU9selVMbC8xN1RVUkMwbk4ybmZaUVhxREhyWXhqWGk4SkgwN3lOTytBRkoyUE42NWoK"
    }
  }
}
